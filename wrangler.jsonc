{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bkng",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Keep the free workers.dev address switched on, so a fresh install is reachable before any domain is connected.
  "workers_dev": true,
  // Builds the interface into ./dist before every deploy and dev session.
  "build": { "command": "npm run build" },
  // The Worker answers every request itself so it can serve the app under any base path.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  // The Deploy to Cloudflare button provisions this database automatically.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bkng"
    }
  ],
  // One trigger for reminders and calendar feed refreshes (free plan allows 5 per account).
  "triggers": { "crons": ["*/15 * * * *"] }
}
